{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelhost.dev/schemas/1.0/scan-report.schema.json",
  "title": "ScanReport",
  "description": "The result of ONE execution of ONE engine in a cycle.",
  "type": "object",
  "required": ["schema_version", "scan_id", "engine", "status"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "scan_id": { "type": "string" },
    "engine": { "type": "string" },
    "engine_version": { "type": "string" },
    "signatures_updated_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "object",
      "description": "The ORCHESTRATOR decides the file list; the adapter never chooses the scope.",
      "properties": {
        "root": { "type": "string" },
        "mode": { "type": "string", "enum": ["incremental", "full", "targeted"] },
        "files_considered": { "type": "integer", "minimum": 0 },
        "files_scanned": { "type": "integer", "minimum": 0 },
        "skipped_reason_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "examples": [{ "unchanged": 17801, "too_large": 12, "unreadable": 9 }]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["completed", "partial", "failed", "timeout", "killed"],
      "description": "Only 'completed' may count as a vote in the consensus. Any other status is an abstention — never 'the engine found nothing'."
    },
    "error": {
      "type": ["string", "null"],
      "description": "Mandatory when status != completed. A failure status with no reason turns a diagnosable problem into a mystery."
    },
    "resource_usage": {
      "type": "object",
      "properties": {
        "wall_seconds": { "type": "number", "minimum": 0 },
        "max_rss_mb": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "finding.schema.json" }
    },
    "clean_files": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "description": "Hashes this engine POSITIVELY asserts are legitimate. Only wp-checksums fills this in. The basis of the anti-false-positive protection."
    },
    "raw_ref": {
      "type": "string",
      "description": "A pointer to the archived raw output, for auditing and for reprocessing through Parse()."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["partial", "failed", "timeout", "killed"] } },
        "required": ["status"]
      },
      "then": { "required": ["error"] }
    }
  ]
}
