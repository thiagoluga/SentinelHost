{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelhost.dev/schemas/1.0/verdict.schema.json",
  "title": "Verdict",
  "description": "The consolidated decision about ONE file. Produced by the verdict engine, never by adapters.",
  "type": "object",
  "required": ["schema_version", "verdict_id", "file_sha256", "level", "score", "votes"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "verdict_id": { "type": "string" },
    "file_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file_path": { "type": "string" },
    "file_size": { "type": "integer", "minimum": 0 },
    "level": {
      "type": "string",
      "enum": ["confirmed", "likely", "suspicious", "clean"],
      "description": "confirmed: score >= 0.9, automatic quarantine + alert. likely: 0.6-0.9, waits for a decision. suspicious: 0.3-0.6, report only. clean: < 0.3 or whitelisted."
    },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "votes": {
      "type": "array",
      "description": "What makes the consensus auditable. The user can always answer 'why was this file quarantined?'.",
      "items": {
        "type": "object",
        "required": ["engine", "weight", "effective_weight"],
        "properties": {
          "engine": { "type": "string" },
          "finding_id": { "type": "string" },
          "weight": { "type": "number", "minimum": 0 },
          "confidence": { "type": "string", "enum": ["signature", "heuristic", "anomaly"] },
          "effective_weight": {
            "type": "number",
            "minimum": 0,
            "description": "weight x the confidence multiplier. It is the number that actually entered the sum."
          },
          "rule": { "type": "string" },
          "category": { "type": "string" }
        }
      }
    },
    "abstentions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Engines that could not weigh in. Recorded for transparency; they do NOT enter the score's calculation."
    },
    "clean_reason": {
      "type": "string",
      "enum": ["official_checksum_match"],
      "description": "Explains a level=clean that contradicts the votes. A file identical to the official WordPress checksum is never quarantined, regardless of votes."
    },
    "action_taken": {
      "type": "string",
      "enum": [
        "none", "quarantined", "recommended", "skipped_whitelist",
        "skipped_official_checksum", "rescan_needed", "failed", "restored", "ignored"
      ]
    },
    "action_at": { "type": "string", "format": "date-time" },
    "action_error": { "type": "string" },
    "quarantine_ref": { "type": "string" },
    "acknowledged_by_user": { "type": "boolean" },
    "acknowledged_at": { "type": "string", "format": "date-time" },
    "scan_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "action_taken": { "const": "quarantined" } },
        "required": ["action_taken"]
      },
      "then": {
        "required": ["quarantine_ref"],
        "description": "Without quarantine_ref the file is not restorable — it would violate Principle I."
      }
    },
    {
      "if": {
        "properties": { "action_taken": { "const": "failed" } },
        "required": ["action_taken"]
      },
      "then": { "required": ["action_error"] }
    }
  ]
}
