{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelhost.dev/schemas/1.0/finding.schema.json",
  "title": "Finding",
  "description": "One individual finding from ONE engine about ONE file, already normalized. Consolidation across engines happens in the Verdict, never here.",
  "type": "object",
  "required": ["schema_version", "engine", "rule", "category", "severity", "confidence", "detected_at"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "id": {
      "type": "string",
      "description": "Generated by the orchestrator, never by the adapter."
    },
    "kind": {
      "type": "string",
      "enum": ["malware", "vulnerability", "hardening"],
      "default": "malware"
    },
    "engine": {
      "type": "string",
      "description": "The engine's unique slug.",
      "examples": ["maldet", "php-malware-finder", "amwscan", "wordfence-cli", "clamav", "wp-checksums"]
    },
    "engine_version": { "type": "string" },
    "rule": {
      "type": "string",
      "description": "The name of the signature/rule that matched, as the engine reports it.",
      "minLength": 1
    },
    "rule_ref": { "type": "string", "format": "uri" },
    "file": { "$ref": "#/$defs/fileRef" },
    "category": {
      "type": "string",
      "enum": [
        "known_malware", "obfuscation", "backdoor", "webshell", "injection",
        "spam_seo", "phishing", "dropper", "core_integrity",
        "suspicious_location", "suspicious_perms", "vulnerable_component", "other"
      ],
      "description": "Each adapter keeps its own rule->category table. Whatever does not map becomes 'other' — it is never discarded."
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"],
      "description": "The severity AS THE ENGINE SEES IT, normalized by the adapter."
    },
    "confidence": {
      "type": "string",
      "enum": ["signature", "heuristic", "anomaly"],
      "description": "It feeds the vote's weight: signature=an exact hash/signature, heuristic=a pattern/behaviour, anomaly=out of the ordinary."
    },
    "matched_content": {
      "type": "string",
      "maxLength": 512,
      "description": "The snippet that triggered the rule, truncated to 512 bytes and sanitized. Never executable."
    },
    "matched_offset": { "type": "integer", "minimum": 0 },
    "component": { "$ref": "#/$defs/component" },
    "scan_id": { "type": "string" },
    "detected_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "vulnerability" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["component"],
        "description": "Vulnerability verdicts are consolidated per component, not per file."
      },
      "else": {
        "required": ["file"],
        "description": "Malware findings require file.sha256: it is the deduplication key across engines."
      }
    }
  ],
  "$defs": {
    "fileRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Mandatory and lowercase. The same file flagged by N engines = N votes on the same target."
        },
        "md5": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "mtime": { "type": "string", "format": "date-time" },
        "owner": { "type": "string" },
        "perms": {
          "type": "string",
          "pattern": "^0[0-7]{3}$",
          "description": "Octal. Preserved so the restore gives the file back exactly as it was."
        }
      }
    },
    "component": {
      "type": "object",
      "required": ["type", "slug", "installed_version"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["wordpress-plugin", "wordpress-theme", "wordpress-core", "composer-package", "npm-package"]
        },
        "slug": { "type": "string" },
        "installed_version": { "type": "string" },
        "fixed_in": { "type": "string" },
        "vuln_ids": { "type": "array", "items": { "type": "string" } },
        "cvss": { "type": "number", "minimum": 0, "maximum": 10 },
        "exploited_in_wild": { "type": "boolean" }
      }
    }
  }
}
