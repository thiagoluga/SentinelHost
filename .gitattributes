# The project's target is Linux userland. Everything that runs there needs LF, even
# when the repository is cloned on Windows.
* text=auto eol=lf

*.sh      text eol=lf
Makefile  text eol=lf
*.go      text eol=lf
*.toml    text eol=lf

# Engine raw-output fixtures are a contract: no normalization at all.
tests/testdata/raw/** -text
tests/testdata/corpus/** -text
