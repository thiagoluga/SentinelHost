.git/
.sentinelhost/

# All of dist/ stays out, EXCEPT the linux/amd64 binary the validation image copies
# (it compiles nothing inside — see docker/Dockerfile.validation).
dist/*
!dist/sentinelhost-linux-amd64

# docs/schema-and-adapters.md trips an antivirus heuristic on a Windows workstation
# and can end up unreadable in the build context. It is not needed in order to
# validate the engines.
docs/
