# Artefatos de build.
#
# As barras iniciais NAO sao decorativas: sem elas, o padrao `sentinelhost`
# casa qualquer arquivo OU DIRETORIO com esse nome em qualquer nivel — e o
# primeiro alvo seria `cmd/sentinelhost/`, que e o programa inteiro.
/dist/
/bin/
/sentinelhost
/sentinelhost.exe

# Dados de runtime (nunca versionados)
/.sentinelhost/
*.db
*.db-wal
*.db-shm

# Ferramentas
/tools/bin/

# Sistema operacional / editores
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Artefatos de release gerados localmente
/dist/
