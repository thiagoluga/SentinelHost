# Build artifacts.
#
# The leading slashes are NOT decorative: without them, the pattern `sentinelhost`
# matches any file OR DIRECTORY with that name at any depth — and the first target
# would be `cmd/sentinelhost/`, which is the whole program.
/dist/
/bin/
/sentinelhost
/sentinelhost.exe

# Runtime data (never versioned)
/.sentinelhost/
*.db
*.db-wal
*.db-shm

# Tooling
/tools/bin/

# Operating system / editors
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Release artifacts built locally
/dist/
